#include <stdint.h>

#define SCB_CPACR (*(volatile unsigned int*)0xE000ED88)

void FPU_Enable(void) {
    SCB_CPACR |= ((3UL << 20) | (3UL << 22));
}

void delay(volatile unsigned int count){
	while(count--);}

int main(void)
{
	FPU_Enable();
	//0x40023800 adresinde bulunan RCC_AHB1ENR registerı tanımlandı.
    volatile unsigned int *RCC_AHB1ENR = (volatile unsigned int*)0x40023830;

    //RCC_AHB1ENR register'ının GPIOD portunun girişi olan 3. biti açıldı.(1 yapıldı).
    *RCC_AHB1ENR |= (1<<3);

    //0x40020C00 adresinde bulunan GPIOD_MODER resgisterı tanımlandı.
    volatile unsigned int *GPIOD_MODER = (volatile unsigned int*)0x40020C00;

    //GPIOD_MODER registerı her ihtimale karşı sıfırlandı.
    *GPIOD_MODER &= ~(3<<(13*2));

    //GPIOD_MODER registerı 01(output) yapıldı.
    *GPIOD_MODER |= (1<<(13*2));

    volatile unsigned int *GPIOD_ODR = (volatile unsigned int*)0x40020C14;


    while (1) {

    	*GPIOD_ODR |= (1<<13);
    	delay(5);
    	*GPIOD_ODR &= (1<<13);
    	delay(5);
    }
    return 0;
}
